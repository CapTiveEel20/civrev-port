// Resources for CivRev.exe. build\civrev.ico is generated by build_launcher.ps1
// from the game's ICON0.PNG (game art: lives only in the git-ignored build\).
#include <windows.h>

1 ICON "build\\civrev.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Civilization Revolution (PC port launcher)"
            VALUE "ProductName", "Civilization Revolution PC port"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "OriginalFilename", "CivRev.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
